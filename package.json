{
    "name": "cycling-ble",
    "version": "0.2.0",
    "description": "Connect to cycling power, heart rate, cadence, and FTMS trainer sensors over Web Bluetooth",
    "type": "module",
    "license": "MIT",
    "author": "Christian Olsson",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/colscoding/cycling-ble.git"
    },
    "bugs": {
        "url": "https://github.com/colscoding/cycling-ble/issues"
    },
    "homepage": "https://github.com/colscoding/cycling-ble#readme",
    "keywords": [
        "bluetooth",
        "web-bluetooth",
        "ble",
        "cycling",
        "power-meter",
        "heart-rate",
        "cadence",
        "ftms",
        "fitness"
    ],
    "engines": {
        "node": ">=22.0.0"
    },
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./parsers": {
            "types": "./dist/parsers/index.d.ts",
            "default": "./dist/parsers/index.js"
        },
        "./mock": {
            "types": "./dist/mock.d.ts",
            "default": "./dist/mock.js"
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "tsx --test \"test/**/*.test.ts\"",
        "test:package": "node --test scripts/check-package.mjs",
        "test:release": "node --test scripts/release.test.mjs",
        "release:dry-run": "node scripts/release.mjs --dry-run",
        "release:verify": "node scripts/release.mjs --verify",
        "release": "node scripts/release.mjs --publish",
        "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude=\"test/**\" --test-coverage-lines=98 --test-coverage-branches=95 --test-coverage-functions=90 \"test/**/*.test.ts\"",
        "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run test:release && pnpm run build && pnpm run test:package",
        "prepublishOnly": "pnpm run check"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@types/web-bluetooth": "^0.0.22",
        "eslint": "^10.13.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "packageManager": "pnpm@12.16.0+sha512.e9ccc91a0b8d52da297c16841f9ee05f3ddd631bd757ef26a211687d4a38de653c614453649294438c58be74c2ba62d53e633a4e153708c012296d0f3ee27b36"
}
